# Template only. Copy to backend/.env and fill in real values.
# Never commit backend/.env.

APP_NAME=Lyra
APP_TAGLINE=AI-powered GATE prep
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Generate a long random string for JWT/session signing
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

STARTER_CREDITS=75
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://localhost:3000

# Neon (or any Postgres). Use the SQLAlchemy + psycopg3 prefix:
# postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/dbname?sslmode=require

# Google OAuth — Authorized redirect URI:
# http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM: openai | azure_openai | stub
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# OCR: stub | vision_llm | azure
OCR_PROVIDER=stub
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Files: local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT_URL=

# Optional cache (not required for local MVP)
REDIS_URL=redis://localhost:6379/0
